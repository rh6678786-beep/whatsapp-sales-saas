# ============================================
# SaaS Closer AI — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---------- Server ----------
NODE_ENV=production
PORT=3000

# ---------- Gemini AI ----------
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---------- Firebase (optional) ----------
# Set these if you want Firestore instead of local mock storage.
# Leave empty to use in-memory mock mode.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID_2=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=

# ---------- JWT Auth ----------
# Change this to a random 64-character string in production
# You can generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-secret-in-production

# ---------- Stripe Billing (optional) ----------
# Leave empty to use mock mode (upgrades work instantly)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (create these in your Stripe Dashboard)
STRIPE_STARTER_PRICE_ID=
STRIPE_PROFESSIONAL_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ---------- WhatsApp ----------
# whatsapp-web.js will auto-detect Chromium;
# set CHROMIUM_PATH if using a custom install
CHROMIUM_PATH=

# ---------- Social Channels ----------
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---------- SMTP (required for OTP email verification) ----------
# Used to send OTP codes during registration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@saascloser.ai

# ---------- Super Admin (optional) ----------
# Used only for the initial password-verify fallback
ADMIN_PASSWORD=admin123
