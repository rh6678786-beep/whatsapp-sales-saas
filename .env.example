# =============================================================================
# WhatsApp AI Sales SaaS — Environment Configuration
# =============================================================================
# CRITICAL SECURITY NOTICE:
# 1. NEVER commit .env (real secrets) to version control
# 2. Use this template only for reference
# 3. Store secrets in: AWS Secrets Manager, Azure Key Vault, HashiCorp Vault
# 4. Rotate secrets regularly (monthly recommended)
# 5. Use unique passwords per environment (dev/staging/production)
# =============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com

# Database Configuration
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://postgres:your-secure-password@db:5432/saascloser
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# Redis Configuration
# IMPORTANT: Use strong password, don't use default 'redis'
REDIS_URL=redis://:your-redis-password@redis:6379/0
REDIS_PASSWORD=your-strong-redis-password

# Authentication & Secrets
# Generate: openssl rand -base64 32 (minimum 32 characters)
JWT_SECRET=your-jwt-secret-minimum-32-characters-generated-with-openssl

# Data Encryption Key (DO NOT CHANGE after production use - data won't decrypt)
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-base64-generated-with-openssl

# Google Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-from-https://ai.google.dev
AI_MONTHLY_BUDGET=100

# Stripe Payment Configuration
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_live_secret_key_not_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Stripe Product Price IDs (create in Stripe Dashboard)
STRIPE_STARTER_PRICE_ID=price_starter_monthly
STRIPE_PROFESSIONAL_PRICE_ID=price_professional_monthly
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly

# Email Configuration (SMTP)
# For Gmail: Enable 2FA and create App Password (not regular password)
# For SendGrid: Use their SMTP relay endpoint
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=noreply@your-domain.com

# WhatsApp Cloud API Configuration
# =============================================================================
# 1. Go to https://developers.facebook.com/ → Create App → Business
# 2. Add WhatsApp product → Get Phone Number ID & WABA ID
# 3. Generate a permanent access token (Settings → Token → Never expire)
# 4. Set your verify token (any random string for webhook verification)
# =============================================================================
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=your-verify-token-change-this

# Facebook/Instagram OAuth Integration
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
INSTAGRAM_CLIENT_ID=your-instagram-app-id
INSTAGRAM_CLIENT_SECRET=your-instagram-app-secret

# Monitoring & Error Tracking
# Sentry error tracking: https://sentry.io/
SENTRY_DSN=https://your-key@sentry.io/your-project-id

# Application Performance Monitoring
# Elastic APM or similar service
APM_SERVER_URL=https://your-apm-server.example.com
APM_SECRET_TOKEN=your-apm-secret-token

# Logging
LOG_LEVEL=info

# Security
# Super admin ID for accessing super-admin panel
SUPER_ADMIN_ID=your-admin-store-id

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,video/mp4

# Backup Configuration (AWS S3)
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=your-aws-access-key
BACKUP_S3_SECRET_KEY=your-aws-secret-key

# =============================================================================
# DEPLOYMENT SECURITY CHECKLIST
# =============================================================================
# [ ] All placeholder values replaced with real secrets
# [ ] JWT_SECRET: minimum 32 characters, cryptographically random
# [ ] ENCRYPTION_KEY: stored safely, never changed after production deploy
# [ ] DATABASE_URL: uses strong password, TLS enabled
# [ ] REDIS_PASSWORD: strong password set
# [ ] APP_URL: uses HTTPS (not HTTP)
# [ ] NODE_ENV=production
# [ ] STRIPE keys are LIVE (not TEST)
# [ ] All secrets stored in Secret Manager (not in .env file)
# [ ] .env file added to .gitignore
# [ ] No sensitive data in application logs
# [ ] CORS properly configured
# [ ] Rate limits set for expected traffic
# [ ] Monitoring and alerting enabled
# [ ] Database backups tested and verified
# [ ] Email delivery tested
# [ ] SSL/TLS certificate configured
# =============================================================================

# Secret Rotation Notes:
# - Rotate JWT_SECRET every 90 days (will require users to re-login)
# - Rotate API keys (Stripe, Gemini, etc.) every 180 days
# - Rotate ENCRYPTION_KEY only if compromised (data becomes inaccessible)
# - Database password: every 90 days
# - Redis password: every 90 days
