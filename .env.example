# Required
GEMINI_API_KEY=your_gemini_api_key
DATABASE_URL=postgresql://user:pass@host:5432/db
JWT_SECRET=your_jwt_secret_change_this
ADMIN_PASSWORD=admin123

# Optional — Redis (required for BullMQ queues + cache)
REDIS_URL=redis://localhost:6379

# Optional — AI Budget
AI_MONTHLY_BUDGET=100

# Optional — SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@saascloser.ai

# Optional — Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PROFESSIONAL_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# Optional — Facebook/Instagram
FACEBOOK_CLIENT_ID=your_fb_app_id
FACEBOOK_CLIENT_SECRET=your_fb_app_secret

# Optional — Supabase Cloud Backup
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
BACKUP_BUCKET=backups

# Optional
APP_URL=https://your-domain.com
PORT=3000
NODE_ENV=development

# PostgreSQL SSL — set to "false" for Supabase/RDS with self-signed certs
DB_SSL_REJECT_UNAUTHORIZED=true

# Rate limit — max requests per 60s window per admin (default: 500)
RATE_LIMIT_MAX=500
