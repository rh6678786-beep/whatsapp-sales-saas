# =============================================================================
# SaaS Closer AI — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control. NEVER use production values here.
#
# Generate secrets with:
#   openssl rand -hex 64   (for JWT_SECRET, ENCRYPTION_KEY)
#   openssl rand -hex 32   (for session keys)
# =============================================================================

# --- Node Environment ---
NODE_ENV=development

# --- Server ---
PORT=3000
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# Use a STRONG, UNIQUE password. NEVER reuse passwords across environments.
DATABASE_URL=postgresql://user:strong_password@localhost:5432/saascloser?sslmode=require
# Set to false only if you understand the risk (NOT in production)
DB_SSL_REJECT_UNAUTHORIZED=true

# NEVER set this to 0 in production. It disables ALL TLS verification.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# --- Redis (optional — app degrades gracefully without it) ---
REDIS_URL=

# --- Authentication ---
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_to_a_64_char_hex_string
# Change immediately after first login. Minimum 8 chars with upper, lower, number, special.
ADMIN_PASSWORD=change_me_now

# --- Google Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here
AI_MONTHLY_BUDGET=100

# --- Stripe Payments ---
# Use your LIVE keys in production, TEST keys in development
STRIPE_SECRET_KEY=sk_test_...
STRIPE_STARTER_PRICE_ID=price_xxx
STRIPE_PROFESSIONAL_PRICE_ID=price_xxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_...

# --- SMTP (Email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Use an App Password (not your regular password) for Gmail
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@saascloser.ai

# --- Facebook / Instagram OAuth ---
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# --- Encryption (Secrets at Rest) ---
# Generate with: openssl rand -hex 32
# WARNING: Once set, changing this will break access to all encrypted data.
ENCRYPTION_KEY=change_me_to_a_64_char_hex_string
